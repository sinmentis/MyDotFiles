{
  "$help": "https://aka.ms/terminal-documentation",
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "actions": [
    {
      "command": {
        "action": "quakeMode"
      },
      "keys": "ctrl+`"
    }
  ],
  "copyFormatting": "none",
  "copyOnSelect": false,
  "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
  "keybindings": [
    {
      "id": "Terminal.DuplicatePaneAuto",
      "keys": "alt+shift+d"
    }
  ],
  "profiles": {
    "defaults": {
      "font": {
        "face": "JetBrainsMono NFM"
      },
      "opacity": 75,
      "useAcrylic": true
    }
  }
}
