[include]
	path = ~/.gitconfig.local

[init]
	defaultBranch = main

[alias]
	co = checkout
	cm = commit
	st = status --short --branch
	sw = switch
	rs = restore
	ft = fetch --all --prune
	lg = log --max-count=100 --graph --decorate --pretty=format:'%C(auto)%h%d %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'

[core]
	autocrlf = input
	editor = code --wait
	longpaths = true
	pager = delta

[interactive]
	diffFilter = delta --color-only

[pager]
	diff = delta
	log = delta
	reflog = delta
	show = delta
	blame = delta

[delta]
	dark = true
	hyperlinks = true
	hyperlinks-file-link-format = "vscode://file/{path}:{line}"
	line-numbers = true
	navigate = true
	side-by-side = true
	syntax-theme = gruvbox-dark

[diff]
	algorithm = histogram
	colorMoved = default
	renames = copies

[fetch]
	prune = true

[merge]
	conflictStyle = zdiff3
	tool = vscode

[mergetool "vscode"]
	cmd = code --wait \"$MERGED\"

[pull]
	ff = only

[push]
	autoSetupRemote = true

[rerere]
	enabled = true
	autoupdate = true

[safe]
	bareRepository = explicit
