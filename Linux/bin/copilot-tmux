#!/usr/bin/env python3

"""Save and restore tmux windows running Copilot CLI sessions."""

import argparse
import json
import os
import re
import shlex
import shutil
import sqlite3
import subprocess
import sys
import uuid
from collections import defaultdict, deque
from datetime import datetime, timezone
from pathlib import Path


HOME = Path.home()
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "copilot-tmux"
SNAPSHOT_PATH = STATE_DIR / "snapshot.json"
COPILOT_STATE_DIR = HOME / ".copilot" / "session-state"
COPILOT_STORE = HOME / ".copilot" / "session-store.db"
AGENCY_PATH = HOME / ".config" / "agency" / "CurrentVersion" / "agency"
TMUX = shutil.which("tmux")
FIELD_SEPARATOR = "__COPILOT_TMUX_FIELD__"
SESSION_ID_PATTERN = re.compile(
    r"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
    re.IGNORECASE,
)


class CopilotTmuxError(RuntimeError):
    pass


def run(command, *, capture=True):
    return subprocess.run(
        command,
        check=True,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
    )


def require_tmux():
    if not TMUX:
        raise CopilotTmuxError("tmux is not installed or is not on PATH")


def tmux_output(*args):
    require_tmux()
    try:
        return run([TMUX, *args]).stdout
    except subprocess.CalledProcessError as error:
        message = (error.stderr or error.stdout or str(error)).strip()
        raise CopilotTmuxError(message) from error


def parse_ppid(status_path):
    for line in status_path.read_text(errors="replace").splitlines():
        if line.startswith("PPid:"):
            return int(line.split()[1])
    return 0


def process_table():
    processes = {}
    for proc_dir in Path("/proc").iterdir():
        if not proc_dir.name.isdigit():
            continue
        try:
            raw = (proc_dir / "cmdline").read_bytes()
            argv = [
                value.decode(errors="surrogateescape")
                for value in raw.split(b"\0")
                if value
            ]
            if not argv:
                continue
            processes[int(proc_dir.name)] = {
                "ppid": parse_ppid(proc_dir / "status"),
                "argv": argv,
            }
        except (FileNotFoundError, PermissionError, ProcessLookupError, ValueError):
            continue
    return processes


def descendant_processes(root_pid, processes):
    children = defaultdict(list)
    for pid, process in processes.items():
        children[process["ppid"]].append(pid)

    result = []
    queue = deque([(root_pid, 0)])
    seen = set()
    while queue:
        pid, depth = queue.popleft()
        if pid in seen:
            continue
        seen.add(pid)
        if pid in processes:
            result.append((pid, depth, processes[pid]))
        for child in children.get(pid, []):
            queue.append((child, depth + 1))
    return result


def option_value(argv, option):
    for index, argument in enumerate(argv):
        if argument == option and index + 1 < len(argv):
            return argv[index + 1]
        prefix = option + "="
        if argument.startswith(prefix):
            return argument[len(prefix) :]
    return None


def strip_session_control(argv):
    result = []
    index = 0
    while index < len(argv):
        argument = argv[index]
        if argument in {"--continue"}:
            index += 1
            continue
        if argument in {"--resume", "-r", "--session-id", "--new-session-id"}:
            index += 2
            continue
        if (
            argument.startswith("--resume=")
            or argument.startswith("--session-id=")
            or argument.startswith("--new-session-id=")
            or argument.startswith("-r=")
            or (argument.startswith("-r") and len(argument) > 2)
        ):
            index += 1
            continue
        result.append(argument)
        index += 1
    return result


def inuse_session_ids(copilot_pid):
    session_ids = set()
    fd_dir = Path("/proc") / str(copilot_pid) / "fd"
    try:
        descriptors = list(fd_dir.iterdir())
    except (FileNotFoundError, PermissionError, ProcessLookupError):
        return session_ids

    for descriptor in descriptors:
        try:
            target = os.readlink(descriptor)
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
        target = target.removesuffix(" (deleted)")
        path = Path(target)
        if (
            path.name == f"inuse.{copilot_pid}.hold"
            and path.parent.parent == COPILOT_STATE_DIR
            and SESSION_ID_PATTERN.fullmatch(path.parent.name)
        ):
            session_ids.add(path.parent.name)
    return session_ids


def parse_workspace_metadata(session_id):
    path = COPILOT_STATE_DIR / session_id / "workspace.yaml"
    try:
        lines = path.read_text(errors="replace").splitlines()
    except OSError:
        return {}

    metadata = {}
    wanted = {"name", "cwd", "repository", "branch", "updated_at"}
    for line in lines:
        if not line or line[0].isspace() or ":" not in line:
            continue
        key, value = line.split(":", 1)
        if key not in wanted:
            continue
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] == '"':
            try:
                value = json.loads(value)
            except json.JSONDecodeError:
                pass
        elif len(value) >= 2 and value[0] == value[-1] == "'":
            value = value[1:-1].replace("''", "'")
        metadata[key] = value
    return metadata


def session_activity(session_id):
    session_dir = COPILOT_STATE_DIR / session_id
    activity = 0
    for name in ("events.jsonl", "workspace.yaml"):
        try:
            activity = max(activity, (session_dir / name).stat().st_mtime_ns)
        except OSError:
            pass
    return activity


def active_session_id(copilot_pid, initial_session_id, pane_title):
    live_candidates = inuse_session_ids(copilot_pid)
    if len(live_candidates) == 1:
        return next(iter(live_candidates)), "live-hold"

    candidates = live_candidates or {initial_session_id}
    if len(candidates) == 1:
        return initial_session_id, "process"

    title = pane_title.removesuffix(" - GitHub Copilot")
    title_matches = []
    for session_id in candidates:
        name = parse_workspace_metadata(session_id).get("name")
        if name and (title == name or title.startswith(name + " - ")):
            title_matches.append((len(name), session_activity(session_id), session_id))
    if title_matches:
        return max(title_matches)[2], "pane-title"

    return (
        max(candidates, key=lambda value: (session_activity(value), value)),
        "activity",
    )


def resolve_launcher(root_pid, pane_title, processes):
    descendants = descendant_processes(root_pid, processes)
    agency_candidates = []
    copilot_candidates = []

    for pid, depth, process in descendants:
        argv = process["argv"]
        executable = Path(argv[0]).name
        if executable == "agency" and len(argv) > 1 and argv[1] == "copilot":
            agency_candidates.append((depth, pid, argv))
        if executable == "copilot":
            session_id = option_value(argv, "--session-id") or option_value(
                argv,
                "--new-session-id",
            )
            if session_id:
                copilot_candidates.append((depth, pid, argv, session_id))

    if not copilot_candidates:
        return None

    _, copilot_pid, copilot_argv, initial_session_id = min(copilot_candidates)
    try:
        parsed_id = uuid.UUID(initial_session_id)
    except ValueError:
        return None
    if parsed_id.version != 4:
        return None
    session_id, session_detection = active_session_id(
        copilot_pid,
        initial_session_id,
        pane_title,
    )

    if agency_candidates:
        _, launcher_pid, launcher_argv = min(agency_candidates)
        launcher = strip_session_control(list(launcher_argv))
        if AGENCY_PATH.is_file() and os.access(AGENCY_PATH, os.X_OK):
            launcher[0] = str(AGENCY_PATH)
        kind = "agency"
    else:
        launcher_pid = copilot_pid
        launcher = strip_session_control(list(copilot_argv))
        kind = "copilot"

    return {
        "session_id": session_id,
        "initial_session_id": initial_session_id,
        "session_detection": session_detection,
        "launcher_pid": launcher_pid,
        "copilot_pid": copilot_pid,
        "launcher_kind": kind,
        "launcher": launcher,
    }


def session_metadata(session_id):
    metadata = parse_workspace_metadata(session_id)
    if not COPILOT_STORE.is_file():
        return metadata
    try:
        connection = sqlite3.connect(
            f"file:{COPILOT_STORE}?mode=ro",
            uri=True,
            timeout=1,
        )
        try:
            row = connection.execute(
                """
                SELECT cwd, repository, branch, summary, updated_at
                FROM sessions
                WHERE id = ?
                """,
                (session_id,),
            ).fetchone()
        finally:
            connection.close()
    except sqlite3.Error:
        return metadata

    if not row:
        return metadata
    keys = ("cwd", "repository", "branch", "summary", "updated_at")
    for key, value in zip(keys, row):
        if value is not None and key not in metadata:
            metadata[key] = value
    return metadata


def list_tmux_panes():
    format_string = FIELD_SEPARATOR.join(
        [
            "#{session_name}",
            "#{window_index}",
            "#{window_name}",
            "#{window_active}",
            "#{window_panes}",
            "#{pane_index}",
            "#{pane_id}",
            "#{pane_pid}",
            "#{pane_current_path}",
            "#{pane_title}",
        ]
    )
    try:
        output = tmux_output("list-panes", "-a", "-F", format_string)
    except CopilotTmuxError as error:
        if "no server running" in str(error) or "failed to connect" in str(error):
            return []
        raise

    panes = []
    for line in output.splitlines():
        fields = line.split(FIELD_SEPARATOR)
        if len(fields) != 10:
            continue
        (
            session_name,
            window_index,
            window_name,
            window_active,
            window_panes,
            pane_index,
            pane_id,
            pane_pid,
            cwd,
            pane_title,
        ) = fields
        panes.append(
            {
                "tmux_session": session_name,
                "window_index": int(window_index),
                "window_name": window_name,
                "window_active": window_active == "1",
                "window_panes": int(window_panes),
                "pane_index": int(pane_index),
                "pane_id": pane_id,
                "pane_pid": int(pane_pid),
                "cwd": cwd,
                "pane_title": pane_title,
            }
        )
    return panes


def save_snapshot(args):
    processes = process_table()
    entries = []
    copilot_windows = {}

    for pane in list_tmux_panes():
        if args.tmux_session and pane["tmux_session"] != args.tmux_session:
            continue
        launcher = resolve_launcher(
            pane["pane_pid"],
            pane["pane_title"],
            processes,
        )
        if not launcher:
            continue
        window_key = (pane["tmux_session"], pane["window_index"])
        if window_key in copilot_windows:
            previous = copilot_windows[window_key]
            raise CopilotTmuxError(
                "Multiple Copilot panes in one tmux window are not supported: "
                f'{pane["tmux_session"]}:{pane["window_index"]} '
                f'({previous["pane_id"]}, {pane["pane_id"]})'
            )
        copilot_windows[window_key] = pane

        session_id = launcher["session_id"]
        session_dir = COPILOT_STATE_DIR / session_id
        if not session_dir.is_dir():
            raise CopilotTmuxError(
                f"Copilot session directory does not exist: {session_dir}"
            )

        entry = {
            **pane,
            **launcher,
            "metadata": session_metadata(session_id),
        }
        entries.append(entry)

    if not entries:
        scope = (
            f" in tmux session {args.tmux_session!r}"
            if args.tmux_session
            else ""
        )
        raise CopilotTmuxError(f"No running Copilot CLI panes found{scope}")

    entries.sort(key=lambda item: (item["tmux_session"], item["window_index"]))
    snapshot = {
        "schema_version": 1,
        "saved_at": datetime.now(timezone.utc).isoformat(),
        "host": {
            "hostname": os.uname().nodename,
            "home": str(HOME),
        },
        "entries": entries,
    }

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    temporary_path = SNAPSHOT_PATH.with_suffix(".json.tmp")
    temporary_path.write_text(json.dumps(snapshot, indent=2) + "\n")
    os.chmod(temporary_path, 0o600)
    os.replace(temporary_path, SNAPSHOT_PATH)

    print(f"Saved {len(entries)} Copilot sessions to {SNAPSHOT_PATH}")
    print_entries(entries)


def load_snapshot():
    if not SNAPSHOT_PATH.is_file():
        raise CopilotTmuxError(
            f"No snapshot found at {SNAPSHOT_PATH}. Run 'copilot-tmux save' first."
        )
    try:
        snapshot = json.loads(SNAPSHOT_PATH.read_text())
    except (json.JSONDecodeError, OSError) as error:
        raise CopilotTmuxError(f"Cannot read snapshot: {error}") from error
    if snapshot.get("schema_version") != 1 or not snapshot.get("entries"):
        raise CopilotTmuxError("Snapshot has an unsupported or empty format")
    return snapshot


def print_entries(entries):
    for entry in entries:
        location = f'{entry["tmux_session"]}:{entry["window_index"]}'
        metadata = entry.get("metadata", {})
        label = metadata.get("name") or metadata.get("summary")
        suffix = f"  {label}" if label else ""
        print(
            f'  {location:<8} {entry["window_name"]:<18} '
            f'{entry["session_id"]}  {entry["cwd"]}{suffix}'
        )


def existing_tmux_sessions():
    try:
        output = tmux_output("list-sessions", "-F", "#{session_name}")
    except CopilotTmuxError as error:
        if "no server running" in str(error) or "failed to connect" in str(error):
            return set()
        raise
    return set(output.splitlines())


def restore_command(entry):
    launcher = list(entry["launcher"])
    launcher.append(f'--resume={entry["session_id"]}')
    return shlex.join(launcher)


def display_tmux_command(command):
    print("$ " + shlex.join(command))


def restore_snapshot(args):
    snapshot = load_snapshot()
    entries = snapshot["entries"]
    grouped = defaultdict(list)
    for entry in entries:
        grouped[entry["tmux_session"]].append(entry)
    for group_entries in grouped.values():
        group_entries.sort(key=lambda item: item["window_index"])

    existing = existing_tmux_sessions()
    collisions = sorted(existing.intersection(grouped))
    if collisions and not args.dry_run:
        raise CopilotTmuxError(
            "Refusing to overwrite existing tmux sessions: "
            + ", ".join(collisions)
        )

    created_sessions = []
    try:
        for session_name in sorted(grouped):
            group_entries = grouped[session_name]
            first = group_entries[0]
            first_command = restore_command(first)
            command = [
                TMUX,
                "new-session",
                "-d",
                "-s",
                session_name,
                "-n",
                first["window_name"],
                "-c",
                first["cwd"],
                first_command,
            ]
            if args.dry_run:
                display_tmux_command(command)
            else:
                run(command)
                created_sessions.append(session_name)
                actual_index = int(
                    tmux_output(
                        "display-message",
                        "-p",
                        "-t",
                        session_name,
                        "#{window_index}",
                    ).strip()
                )
                if actual_index != first["window_index"]:
                    run(
                        [
                            TMUX,
                            "move-window",
                            "-s",
                            f"{session_name}:{actual_index}",
                            "-t",
                            f'{session_name}:{first["window_index"]}',
                        ]
                    )

            for entry in group_entries[1:]:
                command = [
                    TMUX,
                    "new-window",
                    "-d",
                    "-t",
                    f'{session_name}:{entry["window_index"]}',
                    "-n",
                    entry["window_name"],
                    "-c",
                    entry["cwd"],
                    restore_command(entry),
                ]
                if args.dry_run:
                    display_tmux_command(command)
                else:
                    run(command)

            active = next(
                (entry for entry in group_entries if entry["window_active"]),
                first,
            )
            command = [
                TMUX,
                "select-window",
                "-t",
                f'{session_name}:{active["window_index"]}',
            ]
            if args.dry_run:
                display_tmux_command(command)
            else:
                run(command)
    except Exception:
        for session_name in created_sessions:
            subprocess.run(
                [TMUX, "kill-session", "-t", session_name],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        raise

    if args.dry_run:
        return

    print(f"Restored {len(entries)} Copilot sessions.")
    print_entries(entries)
    if args.no_attach:
        return

    target = sorted(grouped)[0]
    if os.environ.get("TMUX"):
        os.execvp(TMUX, [TMUX, "switch-client", "-t", target])
    if sys.stdin.isatty() and sys.stdout.isatty():
        os.execvp(TMUX, [TMUX, "attach-session", "-t", target])
    print(f"Attach with: tmux attach-session -t {shlex.quote(target)}")


def show_snapshot(_args):
    snapshot = load_snapshot()
    print(f'Saved at: {snapshot["saved_at"]}')
    print(f'Snapshot: {SNAPSHOT_PATH}')
    print_entries(snapshot["entries"])


def build_parser():
    parser = argparse.ArgumentParser(
        description="Save and restore tmux windows running Copilot CLI sessions."
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    save_parser = subparsers.add_parser(
        "save",
        help="Discover active Copilot CLI panes and save their session IDs.",
    )
    save_parser.add_argument(
        "--tmux-session",
        help="Save only panes from this tmux session.",
    )
    save_parser.set_defaults(function=save_snapshot)

    restore_parser = subparsers.add_parser(
        "restore",
        help="Recreate the saved tmux windows and resume every Copilot session.",
    )
    restore_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print the tmux commands without starting anything.",
    )
    restore_parser.add_argument(
        "--no-attach",
        action="store_true",
        help="Restore in the background without attaching to tmux.",
    )
    restore_parser.set_defaults(function=restore_snapshot)

    show_parser = subparsers.add_parser(
        "show",
        help="Show the currently saved snapshot.",
    )
    show_parser.set_defaults(function=show_snapshot)
    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()
    try:
        args.function(args)
    except CopilotTmuxError as error:
        parser.exit(1, f"copilot-tmux: {error}\n")
    except subprocess.CalledProcessError as error:
        message = (error.stderr or error.stdout or str(error)).strip()
        parser.exit(1, f"copilot-tmux: {message}\n")


if __name__ == "__main__":
    main()
