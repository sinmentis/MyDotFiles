{
  "mcpServers": {
    "playwright": {
      "tools": [
        "*"
      ],
      "type": "local",
      "command": "playwright-mcp",
      "args": []
    },
    "azure": {
      "tools": [
        "*"
      ],
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ],
      "env": {
        "AZURE_TOKEN_CREDENTIALS": "AzureCliCredential"
      }
    }
  }
}
