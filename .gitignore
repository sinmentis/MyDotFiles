# Machine-local overrides — never commit these (they hold secrets / employer
# tooling / per-machine config). Only the *.example templates are tracked.
*.local
.gitconfig.local
.zshrc.local

# Copilot machine-local instruction layer (work/private context).
# Keep both the current standard path and the legacy custom path private.
**/copilot/instructions/
**/copilot/local/
**/.copilot/instructions/
**/.copilot/local/
*.instructions.local.md
.copilot-memory.md

# Keyring passphrase (referenced by the WSL keyring block)
keyring-passphrase

# Backups created by the install scripts' link_dotfile helper
*.bak.*
